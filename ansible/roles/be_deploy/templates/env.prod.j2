# Database configuration
DB_URL={{ db.url }}
DB_USERNAME={{ db.user }}
DB_PASSWORD={{ db.password }}
DB_DRIVER={{ db.driver }}

# Redis configuration
REDIS_HOST={{ be.redis.host }}
REDIS_PORT={{ be.redis.port }}
SPRING_REDIS_HOST={{ be.redis.host }}
SPRING_REDIS_PORT={{ be.redis.port }}

# AWS S3 credentials
CLOUD_AWS_CREDENTIALS_ACCESS_KEY={{ be.aws.access_key }}
CLOUD_AWS_CREDENTIALS_SECRET_KEY={{ be.aws.secret_key }}
CLOUD_AWS_REGION_STATIC={{ be.aws.region }}
CLOUD_AWS_S3_BUCKET={{ be.aws.s3_bucket }}

# AI Service
AI_SERVICE_BASE_URL={{ be.ai_service_base_url }}

# MongoDB 설정
MONGO_DB={{ be.mongo.db_name }}
MONGO_DB_URI={{ be.mongo.uri }}

# flyway 설정
FLYWAY_URL={{ db.url }}
FLYWAY_USER={{ db.root_user }}
FLYWAY_PASSWORD={{ db.root_password }}
FLYWAY_SCHEMAS={{ db.name }}

OAUTH_KAKAO_CLIENT_ID={{ be.oauth.kakao.client_id }}
OAUTH_KAKAO_REDIRECT_URI={{ be.oauth.kakao.redirect_uri }}

logging.level.org.springframework.data.redis=DEBUG