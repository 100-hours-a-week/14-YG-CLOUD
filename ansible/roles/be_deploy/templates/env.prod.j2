# Database configuration (MySQL on database server)
DB_URL=jdbc:mysql://10.0.0.2:3306/{{ service_name }}_{{ env }}_db?serverTimezone=Asia/Seoul
DB_USERNAME={{ service_name }}_admin
DB_PASSWORD={{ db.mysql.password }}
DB_DRIVER=com.mysql.cj.jdbc.Driver

# Redis configuration (Master mode - running locally on backend server)
REDIS_HOST={{ db.redis.container_name }}
REDIS_PORT={{ db.redis.port }}
SPRING_REDIS_HOST={{ db.redis.container_name }}
SPRING_REDIS_PORT={{ db.redis.port }}

# AWS S3 credentials
CLOUD_AWS_CREDENTIALS_ACCESS_KEY={{ aws.iam.access_key }}
CLOUD_AWS_CREDENTIALS_SECRET_KEY={{ aws.iam.secret_key }}
CLOUD_AWS_REGION_STATIC={{ aws.s3.region }}
CLOUD_AWS_S3_BUCKET={{ aws.s3.bucket }}

# AI Service (running on AI server)
AI_SERVICE_BASE_URL=http://{{ internal_ips.ai }}:{{ app_ports.ai }}

# MongoDB 설정 (running locally on backend server)
MONGO_DB={{ service_name }}_{{ env }}_db
MONGO_DB_URI=mongodb://{{ db.mongo.host }}:27017

# flyway 설정
FLYWAY_URL=jdbc:mysql://10.0.0.2:3306/{{ service_name }}_{{ env }}_db?serverTimezone=Asia/Seoul
FLYWAY_USER=root
FLYWAY_PASSWORD={{ db.mysql.root_password }}
FLYWAY_SCHEMAS={{ service_name }}_{{ env }}_db

# Kakao OAuth 설정
OAUTH_KAKAO_CLIENT_ID={{ be.oauth.kakao.client_id }}
OAUTH_KAKAO_REDIRECT_URI={{ be.oauth.kakao.redirect_uri }}
OAUTH_KAKAO_COMPLETE_REDIRECT={{ be.oauth.kakao.complete_redirect_uri }}

# OpenAI API Key for AI features
OPENAI_API_KEY={{ ai.openai_api_key }}

logging.level.org.springframework.data.redis=DEBUG