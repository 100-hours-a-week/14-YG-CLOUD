server {
    listen 80;
    server_name {{ nginx.domain }}, www.{{ nginx.domain }};

    return 301 https://{{ nginx.domain }}$request_uri;
}

server {
    listen 443 ssl;
    server_name {{ nginx.domain }};

    ssl_certificate /etc/letsencrypt/live/{{ nginx.domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ nginx.domain }}/privkey.pem;

    root {{ path.nginx }};
    index index.html;

    client_max_body_size 10M;

    location / {
        auth_basic "Restricted Access";
        # auth_basic_user_file /etc/nginx/.htpasswd;

        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://localhost:{{ be.port }};
        proxy_read_timeout 300;
        proxy_connect_timeout 60;
        proxy_send_timeout 300;
        proxy_http_version 1.1;
        
        # Keep-alive 및 연결 유지 설정
        proxy_set_header Connection "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # 기본 헤더
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # SSE 및 스트리밍을 위한 버퍼링 비활성화
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Cache-Control no-cache;
        
        # 청크 전송 인코딩 지원
        chunked_transfer_encoding on;
        
        proxy_pass_header Set-Cookie;

        # add_header Access-Control-Allow-Origin *;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE, PATCH";
        add_header Access-Control-Allow-Headers "*";
    }

    location /generation/ {
        proxy_pass http://localhost:{{ ai.port }};
        proxy_read_timeout 300;
        proxy_connect_timeout 60;
        proxy_send_timeout 300;
        proxy_http_version 1.1;
        
        # Keep-alive 및 연결 유지 설정
        proxy_set_header Connection "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # 기본 헤더
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        
        # SSE 및 스트리밍을 위한 버퍼링 비활성화
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Cache-Control no-cache;
        
        # 청크 전송 인코딩 지원  
        chunked_transfer_encoding on;
    }

    location /grafana/ {
        proxy_pass http://localhost:3000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}