server {
    listen 80;
    server_name {{ nginx.domain }}, www.{{ nginx.domain }};

    return 301 https://{{ nginx.domain }}$request_uri;
}

server {
    listen 443 ssl;
    server_name {{ nginx.domain }};

    ssl_certificate /etc/letsencrypt/live/{{ nginx.domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ nginx.domain }}/privkey.pem;

    root {{ paths.nginx }};
    index index.html;

    client_max_body_size 10M;

    location / {
        auth_basic "Restricted Access";
        auth_basic_user_file /etc/nginx/.htpasswd;

        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://localhost:{{ be.port }};
        proxy_read_timeout 120;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # add_header Access-Control-Allow-Origin *;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE, PATCH";
        add_header Access-Control-Allow-Headers "*";
    }

    location /generation/ {
        proxy_pass http://localhost:{{ ai.port }};
        proxy_read_timeout 120;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}