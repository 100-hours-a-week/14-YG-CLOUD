# React 환경 변수 파일 (.env.prod)
# Vite 빌드 시 사용되는 환경 변수들

# API 엔드포인트 설정
VITE_API_BASE_URL={{ fe.api.base_url }}
VITE_AI_API_BASE_URL={{ fe.api.ai_url }}

# 환경 설정
VITE_APP_ENV={{ env }}
VITE_APP_VERSION={{ git_commit | default('init') }}

# 도메인 설정
VITE_APP_DOMAIN={{ fe.api.domain }}

# 카카오 OAuth 설정
VITE_KAKAO_REST_KEY={{ fe.oauth.kakao.client_id }}
VITE_KAKAO_REDIRECT_URI={{ fe.oauth.kakao.redirect_uri }}

# 빌드 최적화
VITE_APP_BUILD_TIME={{ ansible_date_time.iso8601 }}

# 기타 설정
VITE_APP_TITLE="Moongsan {{ env | title }} Environment"
