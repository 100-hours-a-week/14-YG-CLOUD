# .env.j2

# 모델 설정
LLM_PROVIDER=vertexai
HALLUCINATION_LLM_PROVIDER=vertexai
HALLUCINATION_MODEL_NAME=gemini-2.0-flash-001
MODEL_NAME=gemini-1.5-pro-002

# LangGraph 설정
RECURSION_LIMIT=15
VERBOSE_NODES=False

# openAI
OPENAI_API_KEY={{ ai.openai_api_key }}

# GCP
GOOGLE_APPLICATION_CREDENTIALS={{ paths.secret }}/{{ gcp.ai.credentials }}
GCP_PROJECT={{ gcp.ai.project }}
GCP_LOCATION={{ gcp.ai.location }}

# 태빌리 다계정 키
TAVILY_API_KEY_tony_taek105={{ ai.tavily_api_keys.tony_taek105 }}
TAVILY_API_KEY_tony_0913={{ ai.tavily_api_keys.tony_0913 }}
TAVILY_API_KEY_milo_1={{ ai.tavily_api_keys.milo_1 }}

# 랭스미스
LANGSMITH_TRACING={{ ai.langsmith.tracing }}
LANGSMITH_ENDPOINT={{ ai.langsmith.endpoint }}
LANGSMITH_API_KEY={{ ai.langsmith.api_key }}
LANGSMITH_PROJECT={{ ai.langsmith.project }}

# 랭퓨즈
LANGFUSE_SECRET_KEY={{ ai.langfuse.secret_key }}
LANGFUSE_PUBLIC_KEY={{ ai.langfuse.public_key }}
LANGFUSE_HOST={{ ai.langfuse.host }}

# 기타 설정
KMP_DUPLICATE_LIB_OK=True

PROXY1={{ ai.proxies[0] }}
PROXY2={{ ai.proxies[1] }}
PROXY3={{ ai.proxies[2] }}
PROXY4={{ ai.proxies[3] }}

BACKEND_URL={{ ai.backend_url }}

# APM 설정
ELASTIC_APM_SERVICE_NAME={{ ai.apm.service_name | default('ai-moongsan') }}
ELASTIC_APM_SERVER_URL={{ ai.apm.server_url | default('http://34.47.84.135:8200') }}
ELASTIC_APM_ENVIRONMENT={{ ai.apm.environment | default('production') }}
ELASTIC_APM_CAPTURE_BODY={{ ai.apm.capture_body | default('errors') }}
ELASTIC_APM_CAPTURE_HEADERS={{ ai.apm.capture_headers | default('true') }}