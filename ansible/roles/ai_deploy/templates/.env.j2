# .env.j2

# 모델 설정
LLM_PROVIDER=vertexai
HALLUCINATION_LLM_PROVIDER=vertexai
HALLUCINATION_MODEL_NAME=gemini-2.0-flash-001
MODEL_NAME=gemini-1.5-pro-002

# LangGraph 설정
RECURSION_LIMIT=15
VERBOSE_NODES=False

# openAI
OPENAI_API_KEY={{ ai.openai_api_key }}

# GCP
GOOGLE_APPLICATION_CREDENTIALS={{ path.secret }}/{{ ai.gcp.credentials }}
GCP_PROJECT={{ ai.gcp.project }}
GCP_LOCATION={{ ai.gcp.location }}

# 태빌리 다계정 키
TAVILY_API_KEY_tony_taek105={{ ai.tavily_api_keys.tony_taek105 }}
TAVILY_API_KEY_tony_0913={{ ai.tavily_api_keys.tony_0913 }}
TAVILY_API_KEY_milo_1={{ ai.tavily_api_keys.milo_1 }}

# 랭스미스
LANGSMITH_TRACING={{ ai.langsmith.tracing }}
LANGSMITH_ENDPOINT={{ ai.langsmith.endpoint }}
LANGSMITH_API_KEY={{ ai.langsmith.api_key }}
LANGSMITH_PROJECT={{ ai.langsmith.project }}

# 기타 설정
KMP_DUPLICATE_LIB_OK=True

PROXY1={{ ai.proxies[0] }}
PROXY2={{ ai.proxies[1] }}