[Unit]
Description=FastAPI Service for Moongsan
After=network.target

[Service]
User={{ system.user }}
Group={{ system.user }}
WorkingDirectory={{ project_paths.ai_repo }}
ExecStart={{ project_paths.ai_repo }}/.venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port {{ ai.port }} --log-level debug --access-log
StandardOutput=append:{{ path.log }}/ai_moongsan.log
StandardError=append:{{ path.log }}/ai_moongsan.log
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=300
StartLimitBurst=3
Environment="PATH={{ project_paths.ai_repo }}/.venv/bin"

[Install]
WantedBy=multi-user.target