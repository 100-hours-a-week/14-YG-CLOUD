import os
from fastapi import FastAPI
from api import generate_post

# APM 설정 (환경변수가 설정된 경우에만 활성화)
apm_client = None
if os.getenv('ELASTIC_APM_SERVICE_NAME'):
    try:
        from elasticapm.contrib.starlette import ElasticAPM, make_apm_client
        
        apm_config = {
            'SERVICE_NAME': os.getenv('ELASTIC_APM_SERVICE_NAME', 'ai-moongsan'),
            'SERVER_URL': os.getenv('ELASTIC_APM_SERVER_URL', 'http://localhost:8200'),
            'ENVIRONMENT': os.getenv('ELASTIC_APM_ENVIRONMENT', 'development'),
            'CAPTURE_BODY': os.getenv('ELASTIC_APM_CAPTURE_BODY', 'errors'),
            'CAPTURE_HEADERS': os.getenv('ELASTIC_APM_CAPTURE_HEADERS', 'true').lower() == 'true',
        }
        
        apm_client = make_apm_client(apm_config)
        print(f"✅ APM 클라이언트 초기화 성공: {apm_config['SERVICE_NAME']} -> {apm_config['SERVER_URL']}")
    except ImportError:
        print("⚠️ elastic-apm 라이브러리가 설치되지 않았습니다.")
    except Exception as e:
        print(f"❌ APM 클라이언트 초기화 실패: {e}")

app = FastAPI(
    title="generate_description_server",
    version="0.2.1",
    description="URL to POST(상품 공동구매 주최글 작성 자동화) 서버.",
)

# APM 미들웨어 추가 (클라이언트가 있는 경우에만)
if apm_client:
    app.add_middleware(ElasticAPM, client=apm_client)

app.include_router(generate_post.router)

@app.get("/")
def read_root():
    return {"message": "Hello, this is the 14-YG-AI-server. API is running."}

@app.get("/health")
def health_check():
    return {"status": "ok"}

if __name__ == "__main__":
    import uvicorn
    uvicorn.run("main:app", host="0.0.0.0", port=8100)
