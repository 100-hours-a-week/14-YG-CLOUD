filebeat.inputs:
  - type: filestream
    id: syslog
    paths:
      - /var/log/syslog
    fields:
      log_type: syslog
    fields_under_root: true
    multiline.pattern: '^\['
    multiline.negate: true
    multiline.match: after

  - type: filestream
    id: app_logs
    paths:
      - /home/ubuntu/logs/*.log
    exclude_files: ['\.gz$']
    fields:
      log_type: app
    fields_under_root: true

output.elasticsearch:
  hosts: ["http://elasticsearch:9200"]
  protocol: http