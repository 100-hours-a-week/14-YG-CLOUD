# Redis Configuration Template for Master Mode
# Generated by Ansible for {{ service_name }}-{{ env }} environment
# Deployment Date: {{ ansible_date_time.iso8601 | default('N/A') }}

# Network and Security
bind 0.0.0.0
protected-mode no  
port {{ db.redis.port }}

# General Configuration
timeout {{ db.redis.timeout | default(0) }}
tcp-keepalive {{ db.redis.tcp_keepalive | default(300) }}
tcp-backlog 511

# Memory Management
maxmemory {{ db.redis.maxmemory | default('256mb') }}
maxmemory-policy {{ db.redis.maxmemory_policy | default('allkeys-lru') }}

# Persistence Settings
{% if db.redis.save_intervals is defined %}
{% for interval in db.redis.save_intervals %}
save {{ interval }}
{% endfor %}
{% else %}
save 900 1
save 300 10  
save 60 10000
{% endif %}

# REPLICATION CONFIGURATION - MASTER MODE
# This configuration ensures Redis starts and remains as MASTER
# NO replicaof directive means this instance is a master

# Master-specific settings
replica-read-only no
replica-serve-stale-data yes

# Logging Configuration  
loglevel {{ db.redis.loglevel | default('notice') }}
logfile ""

# Security Configuration
{% if db.redis.password is defined and db.redis.password != '' %}
requirepass {{ db.redis.password }}
{% else %}
# No password set (development/test environment)
{% endif %}

# Performance Settings
latency-monitor-threshold 100
maxclients {{ db.redis.maxclients | default(10000) }}

# Database Configuration
databases {{ db.redis.databases | default(16) }}

# Persistence - AOF disabled for better performance in test environment
appendonly no

# Key Expiration Events  
notify-keyspace-events Ex

# Additional Master Mode Enforcement
# These settings ensure master behavior is maintained
{% if db.redis.password is defined and db.redis.password != '' %}
masterauth {{ db.redis.password }}
{% else %}
# No master authentication for standalone master
{% endif %}
replica-priority 100
