pipeline {
    agent any
    
    environment {
        // Repository 정보
        BACKEND_REPO = 'https://github.com/100-hours-a-week/14-YG-BE.git'
        BACKEND_BRANCH = 'tmp/no-kafka'
        
        // Docker 설정
        DOCKER_IMAGE = 'moongsan/backend'
        DOCKER_TAG = "${BUILD_NUMBER}"
        DOCKERFILE_PATH = '.'
        
        // 배포 대상 (GCP dev 환경)
        TARGET_ENV = 'dev'
        GCP_PROJECT = 'ktb-2-moongsan'
        GCP_ZONE = 'asia-northeast3-a'
        TARGET_INSTANCE = 'moongsan-dev-vm'
        
        // Credentials IDs (Jenkins에서 설정된 것들)
        DOCKERHUB_CREDENTIALS = 'dockerhub-credentials'
        GCP_SSH_KEY = 'gcp-ssh-key'
        
        // 앱 설정
        APP_PORT = '8080'
        HEALTH_CHECK_URL = 'http://localhost:8080/health'
    }
    
    triggers {
        // develop 브랜치에 push 시 자동 트리거
        githubPush()
    }
    
    stages {
        stage('🚀 Setup') {
            steps {
                echo "=== Backend CI/CD Pipeline 시작 ==="
                echo "빌드 번호: ${BUILD_NUMBER}"
                echo "대상 환경: ${TARGET_ENV}"
                echo "Docker 이미지: ${DOCKER_IMAGE}:${DOCKER_TAG}"
                
                // 워크스페이스 정리
                deleteDir()
            }
        }
        
        stage('📥 Source Checkout') {
            steps {
                echo "=== 소스 코드 체크아웃 ==="
                git branch: "${BACKEND_BRANCH}", 
                    url: "${BACKEND_REPO}"
                
                // Git 정보 출력
                sh '''
                    echo "현재 브랜치: $(git branch --show-current)"
                    echo "마지막 커밋: $(git log -1 --oneline)"
                '''
            }
        }
        
        stage('🔍 Code Quality & Security') {
            parallel {
                stage('Static Analysis') {
                    steps {
                        echo "=== 코드 정적 분석 ==="
                        // TODO: SonarQube 또는 기타 정적 분석 도구 연동
                        sh 'echo "정적 분석 수행 중..."'
                    }
                }
                
                stage('Security Scan') {
                    steps {
                        echo "=== 보안 스캔 ==="
                        // TODO: 의존성 취약점 스캔
                        sh 'echo "보안 취약점 스캔 중..."'
                    }
                }
            }
        }
        
        stage('🔨 Build & Test') {
            steps {
                echo "=== Maven 빌드 및 테스트 ==="
                
                // Maven 권한 설정
                sh 'chmod +x ./mvnw'
                
                // 테스트 실행 (빌드 포함)
                sh '''
                    ./mvnw clean test -Dspring.profiles.active=test
                '''
                
                // 테스트 결과 저장
                publishTestResults testResultsPattern: 'target/surefire-reports/*.xml'
                
                // JAR 파일 빌드
                sh '''
                    ./mvnw clean package -DskipTests=true -Dspring.profiles.active=prod
                    ls -la target/
                '''
            }
        }
        
        stage('🐳 Docker Build & Push') {
            steps {
                echo "=== Docker 이미지 빌드 및 푸시 ==="
                
                script {
                    // Docker 이미지 빌드
                    def dockerImage = docker.build("${DOCKER_IMAGE}:${DOCKER_TAG}")
                    
                    // latest 태그도 생성
                    sh "docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${DOCKER_IMAGE}:latest"
                    
                    // Docker Hub에 로그인 후 푸시
                    docker.withRegistry('https://registry.hub.docker.com', DOCKERHUB_CREDENTIALS) {
                        dockerImage.push()
                        dockerImage.push('latest')
                    }
                    
                    echo "✅ Docker 이미지 푸시 완료: ${DOCKER_IMAGE}:${DOCKER_TAG}"
                }
            }
        }
        
        stage('🚀 Deploy to GCP Dev') {
            steps {
                echo "=== GCP dev 환경 배포 ==="
                
                script {
                    // Ansible을 통한 배포
                    sh '''
                        cd /var/jenkins_home/workspace
                        
                        # 14-YG-CLOUD 저장소가 없으면 클론
                        if [ ! -d "14-YG-CLOUD" ]; then
                            git clone https://github.com/100-hours-a-week/14-YG-CLOUD.git
                        fi
                        
                        cd 14-YG-CLOUD
                        git pull origin feat/3tier
                        
                        # Ansible을 통한 백엔드 배포
                        ansible-playbook -i ansible/inventory_dev.ini \
                            ansible/playbooks/be_deploy.yml \
                            -e docker_image_tag=${DOCKER_TAG} \
                            -e target_env=${TARGET_ENV} \
                            --tags backend \
                            --become
                    '''
                }
            }
        }
        
        stage('🔍 Health Check') {
            steps {
                echo "=== 배포 완료 후 Health Check ==="
                
                script {
                    // 애플리케이션 시작 대기
                    sleep(time: 30, unit: 'SECONDS')
                    
                    // Health check 수행
                    sh '''
                        # GCP 인스턴스에서 health check
                        gcloud compute ssh ${TARGET_INSTANCE} \
                            --zone=${GCP_ZONE} \
                            --project=${GCP_PROJECT} \
                            --command="curl -f ${HEALTH_CHECK_URL} || exit 1"
                    '''
                }
            }
        }
        
        stage('🧹 Cleanup') {
            steps {
                echo "=== 정리 작업 ==="
                
                // 로컬 Docker 이미지 정리 (디스크 공간 절약)
                sh '''
                    docker rmi ${DOCKER_IMAGE}:${DOCKER_TAG} || true
                    docker system prune -f || true
                '''
            }
        }
    }
    
    post {
        always {
            echo "=== Pipeline 완료 ==="
            
            // 워크스페이스 정리
            cleanWs()
        }
        
        success {
            echo "✅ Backend 배포 성공!"
            echo "🎉 새로운 버전이 GCP dev 환경에 배포되었습니다."
            echo "🔗 배포된 버전: ${DOCKER_IMAGE}:${DOCKER_TAG}"
            
            // 성공 알림 (필요시 Slack, 이메일 등)
            // slackSend(message: "✅ Backend 배포 성공: ${BUILD_URL}")
        }
        
        failure {
            echo "❌ Backend 배포 실패!"
            echo "🔍 로그를 확인하여 문제를 해결해주세요: ${BUILD_URL}"
            
            // 실패 알림
            // slackSend(message: "❌ Backend 배포 실패: ${BUILD_URL}")
        }
        
        unstable {
            echo "⚠️ Backend 배포가 불안정합니다!"
            echo "🔍 테스트 결과를 확인해주세요: ${BUILD_URL}"
        }
    }
}
