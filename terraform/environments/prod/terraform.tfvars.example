# ========================================
# Production Environment - Terraform Variables Template
# 이 파일을 terraform.tfvars로 복사하여 사용하세요
# ========================================

# GCP 프로젝트 설정
project_id = "your-gcp-project-id"
region     = "asia-northeast3"  
zone       = "asia-northeast3-a"

# 도메인 설정 (실제 운영 도메인으로 변경)
domain = "moongsan.com"

# 환경 설정
environment = "prod"

# SSH 설정 (개인 SSH 키 경로로 변경)
ssh_user             = "ubuntu"
ssh_public_key_path  = "~/.ssh/your-ssh-key.pub"

# VM 머신 타입 설정 (운영 환경에 맞게 조정)
database_machine_type = "e2-standard-2"   # 2 vCPU, 8GB RAM
backend_machine_type  = "e2-standard-2"   # 2 vCPU, 8GB RAM
ai_machine_type       = "e2-highmem-2"    # 2 vCPU, 16GB RAM

# 네트워크 설정 (prod 전용 대역)
vpc_cidr = "10.1.0.0/16"

# 내부 IP 설정 (prod 전용)
internal_ips = {
  database = "10.1.0.2" 
  backend  = "10.1.0.3"
  ai       = "10.1.0.4"
}

# 프론트엔드 GCS 버킷 이름 (전역 고유 이름)
frontend_bucket_name = "your-company-prod-frontend"

# SSL 인증서 도메인 설정
ssl_domains = [
  "moongsan.com",
  "www.moongsan.com"
]

# 공통 태그
common_tags = {
  environment = "prod"
  project     = "moongsan"
  managed_by  = "terraform"
  team        = "devops"
  cost_center = "engineering"
}
