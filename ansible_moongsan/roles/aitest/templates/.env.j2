# .env.j2

# 모델 설정
LLM_PROVIDER="vertexai"
HALLUCINATION_LLM_PROVIDER="vertexai"
HALLUCINATION_MODEL_NAME="gemini-2.0-flash-001"
MODEL_NAME="gemini-1.5-pro-002"

# LangGraph 설정
RECURSION_LIMIT=15
VERBOSE_NODES=False

# openAI
OPENAI_API_KEY={{ openai_api_key }}

# GCP
GOOGLE_APPLICATION_CREDENTIALS="{{ google_application_credentials }}"
GCP_PROJECT={{ gcp_project }}
GCP_LOCATION={{ gcp_location }}

# 태빌리 다계정 키
TAVILY_API_KEY_tony_taek105={{ tavily_api_key_tony_taek105 }}
TAVILY_API_KEY_tony_0913={{ tavily_api_key_tony_0913 }}
TAVILY_API_KEY_milo_1={{ tavily_api_key_milo_1 }}

# 랭스미스
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT={{ langsmith_endpoint }}
LANGSMITH_API_KEY={{ langsmith_api_key }}
LANGSMITH_PROJECT={{ langsmith_project }}

# 기타 설정
KMP_DUPLICATE_LIB_OK=True

PROXY1="{{ proxy1 }}"
PROXY2="{{ proxy2 }}"