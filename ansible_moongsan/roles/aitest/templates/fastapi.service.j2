[Unit]
Description=FastAPI Service for Moongsan
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/14-YG-AI
ExecStart=/home/ubuntu/14-YG-AI/.venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8100 --log-level debug --access-log
StandardOutput=append:/home/ubuntu/logs/ai_moongsan.log
StandardError=append:/home/ubuntu/logs/ai_moongsan.log
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=300
StartLimitBurst=3
Environment="PATH=/home/ubuntu/14-YG-AI/.venv/bin"

[Install]
WantedBy=multi-user.target