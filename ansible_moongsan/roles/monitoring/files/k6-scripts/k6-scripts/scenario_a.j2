import http from 'k6/http';
import { check, sleep } from 'k6';

export let options = {
  vus: 20,
  duration: '1m',
};

export default function () {
  // A-1: 비로그인 사용자의 상품 탐색 흐름
  let resList = http.get('https://moongsan.com/api/group-buys?orderBy=latest&category=1');
  check(resList, { 'A-1 리스트 조회 응답 상태 200': (r) => r.status === 200 });
  sleep(1);

  // A-2: 특정 게시글 상세 조회
  let resDetail = http.get('https://moongsan.com/api/group-buys/15');
  check(resDetail, { 'A-2 상세 조회 응답 상태 200': (r) => r.status === 200 });
  sleep(1);
}